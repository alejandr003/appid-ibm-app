<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - AppID IBM</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f0f2f5;
      min-height: 100vh;
    }
    .navbar {
      background: white;
      padding: 16px 32px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .navbar h2 { color: #333; font-size: 18px; }
    .navbar-right { display: flex; align-items: center; gap: 16px; }
    .navbar-right .user-name { color: #666; font-size: 14px; }
    .profile-btn {
      width: 40px; height: 40px; border-radius: 50%;
      background: #106ebe; color: white;
      display: flex; align-items: center; justify-content: center;
      font-weight: bold; cursor: pointer; position: relative;
      font-size: 16px; border: 2px solid transparent;
      overflow: hidden; flex-shrink: 0;
    }
    .profile-btn img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .profile-btn:hover { border-color: #005a9e; }
    .dropdown {
      display: none; position: absolute; top: 48px; right: 0;
      background: white; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      min-width: 280px; z-index: 100; overflow: hidden;
    }
    .dropdown.show { display: block; }
    .dropdown-header {
      padding: 20px; text-align: center; border-bottom: 1px solid #eee;
    }
    .dropdown-header .avatar {
      width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 12px;
      background: #106ebe; color: white; display: flex;
      align-items: center; justify-content: center; font-size: 24px; font-weight: bold;
      overflow: hidden;
    }
    .dropdown-header .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .dropdown-header .name { font-weight: 600; color: #333; }
    .dropdown-header .email { font-size: 13px; color: #666; margin-top: 4px; }
    .dropdown-body { padding: 12px 20px; }
    .dropdown-body .info-row {
      display: flex; justify-content: space-between; padding: 8px 0;
      font-size: 13px; border-bottom: 1px solid #f5f5f5;
    }
    .dropdown-body .info-row:last-child { border-bottom: none; }
    .dropdown-body .info-row .label { color: #888; }
    .dropdown-body .info-row .value { color: #333; font-weight: 500; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dropdown-footer { padding: 12px 20px; border-top: 1px solid #eee; }
    .logout-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; padding: 10px;
      background: #fee; color: #e33; border: none; border-radius: 8px;
      cursor: pointer; font-size: 14px; text-align: center; text-decoration: none;
    }
    .logout-btn:hover { background: #fdd; }
    .logout-btn svg { width: 16px; height: 16px; fill: currentColor; }
    .container {
      max-width: 800px; margin: 48px auto; padding: 0 24px;
    }
    .welcome-card {
      background: white; border-radius: 16px; padding: 48px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.06); text-align: center;
    }
    .welcome-card .icon-wrap {
      width: 64px; height: 64px; margin: 0 auto 16px;
      background: #e8f5e9; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }
    .welcome-card .icon-wrap svg { width: 32px; height: 32px; fill: #2e7d32; }
    .welcome-card h1 { font-size: 28px; color: #333; margin-bottom: 8px; }
    .welcome-card p { color: #666; font-size: 16px; }
  </style>
</head>
<body>
  <nav class="navbar">
    <h2>AppID IBM</h2>
    <div class="navbar-right">
      <span class="user-name">{{user.name}}</span>
      <div class="profile-btn" onclick="toggleDropdown()">
        {{#if user.avatar}}
          <img src="{{user.avatar}}" alt="avatar" referrerpolicy="no-referrer">
        {{else}}
          {{initials}}
        {{/if}}
      </div>
      <div class="dropdown" id="profileDropdown">
        <div class="dropdown-header">
          <div class="avatar">
            {{#if user.avatar}}
              <img src="{{user.avatar}}" alt="avatar" referrerpolicy="no-referrer">
            {{else}}
              {{initials}}
            {{/if}}
          </div>
          <div class="name">{{user.name}}</div>
          <div class="email">{{user.email}}</div>
        </div>
        <div class="dropdown-body">
          <div class="info-row"><span class="label">ID</span><span class="value">{{user.sub}}</span></div>
          <div class="info-row"><span class="label">Email</span><span class="value">{{user.email}}</span></div>
          <div class="info-row"><span class="label">Nombre</span><span class="value">{{user.name}}</span></div>
          <div class="info-row"><span class="label">Proveedor</span><span class="value">{{#if user.avatar}}Sí{{else}}No{{/if}}</span></div>
        </div>
        <div class="dropdown-footer">
          <a href="/auth/logout" class="logout-btn">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/>
            </svg>
            Cerrar Sesion
          </a>
        </div>
      </div>
    </div>
  </nav>
  <div class="container">
    <div class="welcome-card">
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
        </svg>
      </div>
      <h1>Bienvenido, {{user.name}}!</h1>
      <p>Has iniciado sesion correctamente con IBM AppID.</p>
    </div>
  </div>
  <script>
    function toggleDropdown() {
      document.getElementById('profileDropdown').classList.toggle('show');
    }
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.navbar-right')) {
        document.getElementById('profileDropdown').classList.remove('show');
      }
    });
  </script>
</body>
</html>
